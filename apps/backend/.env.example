# Sandbox (default — testing, fake verifications, test tokens)
BMONI_BASE_URL=https://embedded-dev.bmoni.com
BMONI_API_KEY=pk_your_sandbox_key_here
PORT=3001

# Production (REAL money — needs a PROD key from the BMONI team: developers@bkey.me)
# 1. Get your production key — sandbox keys do NOT work here (401).
# 2. Switch these two lines, restart backend:
# BMONI_BASE_URL=https://embedded.bmoni.com
# BMONI_API_KEY=pk_your_production_key_here
# 3. Production rules: real BVNs, real bank accounts, real irreversible transfers.
#    Never collect visitors' BVNs at events. Use a team-owned account with tiny
#    amounts for live demos. Server-side signing here is a hackathon shortcut —
#    production must sign on-device via bmoni_embedded_sdk (PIN + secure enclave).

# Frontend calls this backend:
NEXT_PUBLIC_BMONI_BACKEND_URL=http://localhost:3001
